<Window x:Class="ApexAuth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexAuth"
        Width="390"
        Height="560"
        MinWidth="370"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Window.RenderTransform>
    <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
  </Window.RenderTransform>
  <Border CornerRadius="24" BorderBrush="#343060" BorderThickness="1" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#000000" Offset="0"/>
        <GradientStop Color="#080719" Offset="0.52"/>
        <GradientStop Color="#000000" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect Color="#121056" BlurRadius="34" ShadowDepth="0" Opacity="0.55"/>
    </Border.Effect>
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Margin="10,10,10,0" Background="#171543" Padding="12" CornerRadius="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="12" BorderBrush="#A8B1FF" BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#8B82FF" Offset="0"/>
                  <GradientStop Color="#4038D8" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect Color="#7069FF" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
              </Border.Effect>
              <TextBlock Text="A" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="Black"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="ApexAuth" FontSize="19" FontWeight="Black" Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="Encrypted local authenticator" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click">
              <TextBlock Text="−" FontSize="18" FontWeight="Black" Margin="0,-3,0,0"/>
            </Button>
            <Button Style="{StaticResource WindowControlButton}" Margin="6,0,0,0" Click="CloseButton_Click">
              <TextBlock Text="×" FontSize="16" FontWeight="Black" Margin="0,-1,0,0"/>
            </Button>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,10,0,0" Padding="4" Background="#100F2F" BorderBrush="#2D2962" BorderThickness="1" CornerRadius="18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ImportButton" Content="Import" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="ImportButton_Click"/>
            <Button x:Name="ExportButton" Grid.Column="1" Content="Export" Style="{StaticResource GhostButton}" Margin="3,0,3,0" Click="ExportButton_Click"/>
            <Button x:Name="LockButton" Grid.Column="2" Content="Lock" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="LockButton_Click"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="LockedPanel" Grid.Row="1" Margin="18">
      <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="20" Padding="20" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect Color="#3D38E8" BlurRadius="34" ShadowDepth="0" Opacity="0.22"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="SECURE SESSION" Foreground="{StaticResource AccentAltBrush}" FontSize="11" FontWeight="Black"/>
          <TextBlock x:Name="LockTitle" Text="Unlock vault" FontSize="24" FontWeight="Black" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"/>
          <TextBlock x:Name="LockSubtitle" Text="Enter your master password to decrypt codes in memory." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
          <Grid>
            <PasswordBox x:Name="MasterPasswordBox" Padding="12,9,42,9" KeyDown="MasterPasswordBox_KeyDown" PasswordChanged="PasswordBox_PasswordChanged"/>
            <TextBox x:Name="MasterPasswordTextBox" Padding="12,9,42,9" Visibility="Collapsed" TextChanged="PasswordTextBox_TextChanged" KeyDown="MasterPasswordBox_KeyDown"/>
            <Button x:Name="MasterRevealButton" Width="32" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Style="{StaticResource WindowControlButton}" Click="MasterRevealButton_Click">
              <Viewbox Width="19" Height="15">
                <Canvas Width="24" Height="18">
                  <Path x:Name="MasterEyeClosed" Stroke="{StaticResource TextBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,6 C8,13 16,13 21,6 M6,10 L4,13 M12,12 L12,16 M18,10 L20,13"/>
                  <Path x:Name="MasterEyeOpen" Visibility="Collapsed" Stroke="{StaticResource TextBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,10 C8,3 16,3 21,10"/>
                  <Ellipse x:Name="MasterEyePupil" Visibility="Collapsed" Fill="{StaticResource TextBrush}" Width="7" Height="7" Canvas.Left="8.5" Canvas.Top="8"/>
                  <Ellipse x:Name="MasterEyeGlint" Visibility="Collapsed" Fill="White" Width="2" Height="2" Canvas.Left="13" Canvas.Top="9"/>
                </Canvas>
              </Viewbox>
            </Button>
          </Grid>
          <Grid x:Name="ConfirmPasswordGrid" Visibility="Collapsed" Margin="0,10,0,0">
            <PasswordBox x:Name="ConfirmPasswordBox" Padding="12,9,42,9" PasswordChanged="PasswordBox_PasswordChanged"/>
            <TextBox x:Name="ConfirmPasswordTextBox" Padding="12,9,42,9" Visibility="Collapsed" TextChanged="PasswordTextBox_TextChanged"/>
            <Button x:Name="ConfirmRevealButton" Width="32" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Style="{StaticResource WindowControlButton}" Click="ConfirmRevealButton_Click">
              <Viewbox Width="19" Height="15">
                <Canvas Width="24" Height="18">
                  <Path x:Name="ConfirmEyeClosed" Stroke="{StaticResource TextBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,6 C8,13 16,13 21,6 M6,10 L4,13 M12,12 L12,16 M18,10 L20,13"/>
                  <Path x:Name="ConfirmEyeOpen" Visibility="Collapsed" Stroke="{StaticResource TextBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,10 C8,3 16,3 21,10"/>
                  <Ellipse x:Name="ConfirmEyePupil" Visibility="Collapsed" Fill="{StaticResource TextBrush}" Width="7" Height="7" Canvas.Left="8.5" Canvas.Top="8"/>
                  <Ellipse x:Name="ConfirmEyeGlint" Visibility="Collapsed" Fill="White" Width="2" Height="2" Canvas.Left="13" Canvas.Top="9"/>
                </Canvas>
              </Viewbox>
            </Button>
          </Grid>
          <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="UnlockButton_Click"/>
          <TextBlock x:Name="LockError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="VaultPanel" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Margin="14,14,14,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="20" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="CycleText" Text="30 seconds" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
            <ProgressBar x:Name="CycleProgress" Height="9" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBrush}" Background="#080716"/>
          </StackPanel>
          <Button Grid.Column="1" Content="+ Add" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="AddButton_Click"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Margin="14,10,14,14" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="AccountsPanel"/>
      </ScrollViewer>
    </Grid>

    <Border x:Name="Toast" Grid.RowSpan="3" Background="#181647" BorderBrush="{StaticResource AccentAltBrush}" BorderThickness="1" CornerRadius="18"
            Padding="14,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Visibility="Collapsed">
      <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
    </Border>
    </Grid>
  </Border>
</Window>

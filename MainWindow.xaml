<Window x:Class="ApexAuth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexAuth"
        Width="400"
        Height="580"
        MinWidth="380"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Window.RenderTransform>
    <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
  </Window.RenderTransform>
  <Border CornerRadius="18" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True"
          Background="{DynamicResource BgBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="1" Color="{DynamicResource WindowShadowColor}"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header ─────────────────────────────────────────────────────────── -->
      <Border Grid.Row="0" Margin="14,14,14,0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1"
              Padding="14,12" CornerRadius="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Clickable logo opens the theme popup -->
            <Button x:Name="LogoButton" Click="LogoButton_Click"
                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                    VerticalAlignment="Center" ToolTip="Appearance"
                    FocusVisualStyle="{StaticResource ApexFocusVisualStyle}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Chrome" Background="Transparent" CornerRadius="12"
                          RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Trigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.06" Duration="0:0:0.18">
                              <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                              </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.06" Duration="0:0:0.18">
                              <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                              </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.EnterActions>
                      <Trigger.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.18"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <Border Width="36" Height="36" CornerRadius="12"
                      BorderBrush="{DynamicResource AccentAltBrush}" BorderThickness="1">
                <Border.Background>
                  <SolidColorBrush Color="{DynamicResource AccentColor}"/>
                </Border.Background>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="1"
                                    Color="{DynamicResource ToastShadowColor}"/>
                </Border.Effect>
                <TextBlock Text="A" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="20" FontWeight="Black"
                           Foreground="{DynamicResource OnAccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Button>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="ApexAuth" FontSize="18" FontWeight="Black"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBlock Text="Encrypted local authenticator" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{DynamicResource WindowControlButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                <Viewbox Width="12" Height="12" IsHitTestVisible="False">
                  <Canvas Width="16" Height="16">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M3.5,8 H12.5"/>
                  </Canvas>
                </Viewbox>
              </Button>
              <Button Style="{DynamicResource WindowControlButton}" Margin="6,0,0,0" Click="CloseButton_Click" ToolTip="Hide to tray">
                <Viewbox Width="12" Height="12" IsHitTestVisible="False">
                  <Canvas Width="16" Height="16">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M4,4 L12,12 M12,4 L4,12"/>
                  </Canvas>
                </Viewbox>
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="1" Background="{DynamicResource LineSoftBrush}" Margin="0,0,0,10"/>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="ImportButton" Content="Import"
                      Style="{DynamicResource GhostButton}" Margin="0,0,4,0" Click="ImportButton_Click"
                      IsEnabled="{Binding IsVisible, ElementName=VaultPanel}"/>
              <Button x:Name="ExportButton" Grid.Column="1" Content="Export"
                      Style="{DynamicResource GhostButton}" Margin="4,0,4,0" Click="ExportButton_Click"
                      IsEnabled="{Binding IsVisible, ElementName=VaultPanel}"/>
              <Button x:Name="LockButton" Grid.Column="2" Content="Lock"
                      Style="{DynamicResource GhostButton}" Margin="4,0,0,0" Click="LockButton_Click"
                      IsEnabled="{Binding IsVisible, ElementName=VaultPanel}"/>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <!-- Locked screen ──────────────────────────────────────────────────── -->
      <Grid x:Name="LockedPanel" Grid.Row="1" Margin="14">
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1"
                CornerRadius="14" Padding="20" VerticalAlignment="Center">
          <StackPanel>
            <Border x:Name="SecureBadge" HorizontalAlignment="Left" CornerRadius="8" Padding="9,4"
                    Background="{DynamicResource AccentSoftBrush}">
              <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="1.0" To="0.55" Duration="0:0:1.6" AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Border.Triggers>
              <TextBlock Text="SECURE SESSION" Foreground="{DynamicResource AccentBrush}"
                         FontSize="10" FontWeight="ExtraBold"/>
            </Border>
            <TextBlock x:Name="LockTitle" Text="Unlock vault" FontSize="22" FontWeight="Black"
                       Foreground="{DynamicResource TextBrush}" Margin="0,12,0,0"/>
            <TextBlock x:Name="LockSubtitle"
                       Text="Enter your master password to decrypt codes in memory."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       FontSize="13" FontWeight="Bold" Margin="0,8,0,16"/>
            <Grid>
              <PasswordBox x:Name="MasterPasswordBox" Padding="12,9,52,9"
                           KeyDown="MasterPasswordBox_KeyDown" PasswordChanged="PasswordBox_PasswordChanged"/>
              <TextBox x:Name="MasterPasswordTextBox" Padding="12,9,52,9" Visibility="Collapsed"
                       TextChanged="PasswordTextBox_TextChanged" KeyDown="MasterPasswordBox_KeyDown"/>
              <Button x:Name="MasterRevealButton"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                      Style="{DynamicResource InlineIconButton}" Click="MasterRevealButton_Click">
                <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                  <Canvas Width="16" Height="16">
                    <Path x:Name="MasterEyeClosed"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M2,4.5 C5,9 11,9 14,4.5 M3.5,7.5 L2,9.5 M8,9.5 L8,11.5 M12.5,7.5 L14,9.5"/>
                    <Path x:Name="MasterEyeOpen" Visibility="Collapsed"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M1.5,8 C4,4 6,3 8,3 C10,3 12,4 14.5,8 C12,12 10,13 8,13 C6,13 4,12 1.5,8 Z"/>
                    <Ellipse x:Name="MasterEyePupil" Visibility="Collapsed"
                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             StrokeThickness="1.5"
                             Width="3.6" Height="3.6"
                             Canvas.Left="6.2" Canvas.Top="6.2"/>
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
            <Grid x:Name="ConfirmPasswordGrid" Visibility="Collapsed" Margin="0,8,0,0">
              <PasswordBox x:Name="ConfirmPasswordBox" Padding="12,9,52,9" PasswordChanged="PasswordBox_PasswordChanged"/>
              <TextBox x:Name="ConfirmPasswordTextBox" Padding="12,9,52,9" Visibility="Collapsed"
                       TextChanged="PasswordTextBox_TextChanged"/>
              <Button x:Name="ConfirmRevealButton"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                      Style="{DynamicResource InlineIconButton}" Click="ConfirmRevealButton_Click">
                <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                  <Canvas Width="16" Height="16">
                    <Path x:Name="ConfirmEyeClosed"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M2,4.5 C5,9 11,9 14,4.5 M3.5,7.5 L2,9.5 M8,9.5 L8,11.5 M12.5,7.5 L14,9.5"/>
                    <Path x:Name="ConfirmEyeOpen" Visibility="Collapsed"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M1.5,8 C4,4 6,3 8,3 C10,3 12,4 14.5,8 C12,12 10,13 8,13 C6,13 4,12 1.5,8 Z"/>
                    <Ellipse x:Name="ConfirmEyePupil" Visibility="Collapsed"
                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             StrokeThickness="1.5"
                             Width="3.6" Height="3.6"
                             Canvas.Left="6.2" Canvas.Top="6.2"/>
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
            <Button x:Name="UnlockButton" Content="Unlock" Style="{DynamicResource PrimaryButton}"
                    Margin="0,16,0,0" Click="UnlockButton_Click"/>
            <TextBlock x:Name="LockError" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Vault panel ────────────────────────────────────────────────────── -->
      <Grid x:Name="VaultPanel" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="14,14,14,0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1"
                CornerRadius="14" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="CycleText" Text="30 seconds until refresh"
                         FontSize="12" FontWeight="Bold"
                         Foreground="{DynamicResource MutedBrush}"/>
              <ProgressBar x:Name="CycleProgress" Height="10" Margin="0,8,0,0"
                           Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ Add" Style="{DynamicResource PrimaryButton}"
                    Margin="14,0,0,0" Click="AddButton_Click" Padding="14,8"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="14,10,8,14" Padding="0,0,6,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="AccountsPanel"/>
        </ScrollViewer>
      </Grid>

      <!-- Toast ──────────────────────────────────────────────────────────── -->
      <Border x:Name="Toast" Grid.RowSpan="3"
              Background="{DynamicResource ToastBgBrush}"
              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
              CornerRadius="12" Padding="16,10"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              MaxWidth="320"
              Margin="0,0,0,18" Visibility="Collapsed"
              RenderTransformOrigin="0.5,1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="1"
                            Color="{DynamicResource ToastShadowColor}"/>
        </Border.Effect>
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource TextBrush}"
                   FontWeight="Bold" FontSize="13"
                   TextWrapping="Wrap" TextAlignment="Center"/>
      </Border>
    </Grid>
  </Border>
</Window>

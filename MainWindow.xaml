<Window x:Class="ApexAuth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexAuth"
        Width="400"
        Height="580"
        MinWidth="380"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Window.RenderTransform>
    <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
  </Window.RenderTransform>
  <Border CornerRadius="18" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True"
          Background="{DynamicResource BgBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="1" Color="{DynamicResource WindowShadowColor}"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header ─────────────────────────────────────────────────────────── -->
      <Border Grid.Row="0" Margin="12,12,12,0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              Padding="14,12" CornerRadius="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Clickable logo opens the theme popup -->
            <Button x:Name="LogoButton" Click="LogoButton_Click"
                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                    VerticalAlignment="Center" ToolTip="Appearance">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Chrome" Background="Transparent" CornerRadius="12">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <Border Width="36" Height="36" CornerRadius="12"
                      BorderBrush="{DynamicResource AccentAltBrush}" BorderThickness="1">
                <Border.Background>
                  <SolidColorBrush Color="{DynamicResource AccentColor}"/>
                </Border.Background>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="1"
                                    Color="{DynamicResource ToastShadowColor}"/>
                </Border.Effect>
                <TextBlock Text="A" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="20" FontWeight="Black"
                           Foreground="{DynamicResource OnAccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Button>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="ApexAuth" FontSize="18" FontWeight="Black"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBlock Text="Encrypted local authenticator" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{DynamicResource WindowControlButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                <TextBlock Text="−" FontSize="18" FontWeight="Black" Margin="0,-3,0,0"/>
              </Button>
              <Button Style="{DynamicResource WindowControlButton}" Margin="6,0,0,0" Click="CloseButton_Click" ToolTip="Hide to tray">
                <TextBlock Text="×" FontSize="16" FontWeight="Black" Margin="0,-1,0,0"/>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Margin="0,12,0,0" Padding="4"
                  Background="{DynamicResource InputBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="ImportButton" Content="Import"
                      Style="{DynamicResource GhostButton}" Margin="0,0,3,0" Click="ImportButton_Click"/>
              <Button x:Name="ExportButton" Grid.Column="1" Content="Export"
                      Style="{DynamicResource GhostButton}" Margin="3,0,3,0" Click="ExportButton_Click"/>
              <Button x:Name="LockButton" Grid.Column="2" Content="Lock"
                      Style="{DynamicResource GhostButton}" Margin="3,0,0,0" Click="LockButton_Click"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Locked screen ──────────────────────────────────────────────────── -->
      <Grid x:Name="LockedPanel" Grid.Row="1" Margin="18">
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="14" Padding="22" VerticalAlignment="Center">
          <StackPanel>
            <Border HorizontalAlignment="Left" CornerRadius="8" Padding="8,3"
                    Background="{DynamicResource AccentSoftBrush}">
              <TextBlock Text="SECURE SESSION" Foreground="{DynamicResource AccentBrush}"
                         FontSize="10" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="LockTitle" Text="Unlock vault" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0"/>
            <TextBlock x:Name="LockSubtitle"
                       Text="Enter your master password to decrypt codes in memory."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       FontSize="13" Margin="0,6,0,18"/>
            <Grid>
              <PasswordBox x:Name="MasterPasswordBox" Padding="12,9,42,9"
                           KeyDown="MasterPasswordBox_KeyDown" PasswordChanged="PasswordBox_PasswordChanged"/>
              <TextBox x:Name="MasterPasswordTextBox" Padding="12,9,42,9" Visibility="Collapsed"
                       TextChanged="PasswordTextBox_TextChanged" KeyDown="MasterPasswordBox_KeyDown"/>
              <Button x:Name="MasterRevealButton" Width="32" Height="28" Padding="0"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                      Style="{DynamicResource WindowControlButton}" Click="MasterRevealButton_Click">
                <Viewbox Width="19" Height="15">
                  <Canvas Width="24" Height="18">
                    <Path x:Name="MasterEyeClosed" Stroke="{DynamicResource TextBrush}" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M3,6 C8,13 16,13 21,6 M6,10 L4,13 M12,12 L12,16 M18,10 L20,13"/>
                    <Path x:Name="MasterEyeOpen" Visibility="Collapsed" Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Data="M3,10 C8,3 16,3 21,10"/>
                    <Ellipse x:Name="MasterEyePupil" Visibility="Collapsed"
                             Fill="{DynamicResource TextBrush}" Width="7" Height="7"
                             Canvas.Left="8.5" Canvas.Top="8"/>
                    <Ellipse x:Name="MasterEyeGlint" Visibility="Collapsed" Fill="White" Width="2" Height="2"
                             Canvas.Left="13" Canvas.Top="9"/>
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
            <Grid x:Name="ConfirmPasswordGrid" Visibility="Collapsed" Margin="0,10,0,0">
              <PasswordBox x:Name="ConfirmPasswordBox" Padding="12,9,42,9" PasswordChanged="PasswordBox_PasswordChanged"/>
              <TextBox x:Name="ConfirmPasswordTextBox" Padding="12,9,42,9" Visibility="Collapsed"
                       TextChanged="PasswordTextBox_TextChanged"/>
              <Button x:Name="ConfirmRevealButton" Width="32" Height="28" Padding="0"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                      Style="{DynamicResource WindowControlButton}" Click="ConfirmRevealButton_Click">
                <Viewbox Width="19" Height="15">
                  <Canvas Width="24" Height="18">
                    <Path x:Name="ConfirmEyeClosed" Stroke="{DynamicResource TextBrush}" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M3,6 C8,13 16,13 21,6 M6,10 L4,13 M12,12 L12,16 M18,10 L20,13"/>
                    <Path x:Name="ConfirmEyeOpen" Visibility="Collapsed" Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Data="M3,10 C8,3 16,3 21,10"/>
                    <Ellipse x:Name="ConfirmEyePupil" Visibility="Collapsed"
                             Fill="{DynamicResource TextBrush}" Width="7" Height="7"
                             Canvas.Left="8.5" Canvas.Top="8"/>
                    <Ellipse x:Name="ConfirmEyeGlint" Visibility="Collapsed" Fill="White"
                             Width="2" Height="2" Canvas.Left="13" Canvas.Top="9"/>
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
            <Button x:Name="UnlockButton" Content="Unlock" Style="{DynamicResource PrimaryButton}"
                    Margin="0,18,0,0" Click="UnlockButton_Click"/>
            <TextBlock x:Name="LockError" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Vault panel ────────────────────────────────────────────────────── -->
      <Grid x:Name="VaultPanel" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="14,14,14,0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="14" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="CycleText" Text="30 seconds until refresh"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}"/>
              <ProgressBar x:Name="CycleProgress" Height="6" Margin="0,8,0,0"
                           Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ Add" Style="{DynamicResource PrimaryButton}"
                    Margin="14,0,0,0" Click="AddButton_Click" Padding="14,8"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="14,10,14,14" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="AccountsPanel"/>
        </ScrollViewer>
      </Grid>

      <!-- Toast ──────────────────────────────────────────────────────────── -->
      <Border x:Name="Toast" Grid.RowSpan="3"
              Background="{DynamicResource ToastBgBrush}"
              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
              CornerRadius="12" Padding="16,10"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,22" Visibility="Collapsed"
              RenderTransformOrigin="0.5,1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="1"
                            Color="{DynamicResource ToastShadowColor}"/>
        </Border.Effect>
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource TextBrush}"
                   FontWeight="SemiBold" FontSize="13"/>
      </Border>
    </Grid>
  </Border>
</Window>
